# Copy this file to .env and fill in your local values.
# When running with Docker, set host to 'db'.
# When running locally, set host to 'localhost'.

SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/gives_charity
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=your_postgres_password_here
SERVER_PORT=8080

JWT_SECRET=your_jwt_secret_key_at_least_32_characters_long
JWT_ACCESS_EXPIRATION=900000
JWT_REFRESH_EXPIRATION=604800000

FROM_MAIL=support@givescharity.org
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=your_smtp_username_here
MAIL_PASSWORD=your_smtp_password_here
MAIL_VERIFY_EXPIRATION=864000000
FRONTEND_URL=http://localhost:3000

GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Default admin user seeded on first startup
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=ChangeMe@123
SEED_ADMIN_FULL_NAME=Admin

GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODELS=gemini-2.5-flash,gemini-2.5-flash-lite,gemini-3-flash-preview,gemini-3.1-flash-lite

WEBEX_CLIENT_ID=your_webex_client_id_here
WEBEX_CLIENT_SECRET=your_webex_client_secret_here
WEBEX_REFRESH_TOKEN=your_webex_refresh_token_here
WEBEX_API_BASE_URL=https://webexapis.com/v1
WEBEX_REDIRECT_URI=http://localhost:8080/api/integrations/webex/oauth/callback

PAYOS_CLIENT_ID=your_payos_client_id_here
PAYOS_API_KEY=your_payos_api_key_here
PAYOS_CHECKSUM_KEY=your_payos_checksum_key_here
PAYOS_CANCEL_URL=http://localhost:3000
PAYOS_RETURN_URL=http://localhost:3000
PAYOS_WEBHOOK_URL=http://localhost:8080/api/donations/payos/webhook
